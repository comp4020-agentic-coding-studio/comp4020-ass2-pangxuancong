---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import CoursePage from "../../layouts/CoursePage.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);
---

<CoursePage
  title={assessment.data.title}
  description={assessment.data.description}
>
  {
    assessment.data.draft && (
      <Callout type="warning">
        <p>
          <strong>Draft.</strong> This brief is still being finalised and may change.
        </p>
      </Callout>
    )
  }
  <div class="brief-head">
    <div class="brief-weight">
      <span class="brief-weight__figure slop-figure">{assessment.data.weight}%</span>
      <span class="slop-label slop-label--quiet">of the course mark</span>
    </div>
    <dl class="brief-facts">
      <div>
        <dt class="slop-label slop-label--quiet">Due</dt>
        <dd class="slop-label slop-label--mono">{formatCourseDate(assessment.data.due)}</dd>
      </div>
      <div>
        <dt class="slop-label slop-label--quiet">Marked on</dt>
        <dd class="brief-note">
          The argument, not the outcome. A defended decision that lost the game
          is not penalised for losing.
        </dd>
      </div>
    </dl>
  </div>
  <Content />
  <SpecList spec={assessment.data.spec}>
    The brief poses the problem and leaves room for a response. The spec is the
    fixed part: what a marker checks. Some lines can be checked mechanically;
    the rest call for judgement.
  </SpecList>
  {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
  <RelatedContent entry={assessment} collections={graphCollections} />
</CoursePage>

<style>
  /* A brief is read to find two things: what it is worth and when it is due.
     Both are above everything else, and the weight is the figure the page
     opens on --- the same treatment the assessment index gives it, so the row
     and the page it leads to agree about what matters. */
  .brief-head {
    display: grid;
    grid-template-columns: minmax(8rem, max-content) minmax(0, 1fr);
    gap: 1rem 2.5rem;
    align-items: start;
    margin-block-end: 2.5rem;
    padding-block-end: 1.5rem;
    border-block-end: var(--slop-rule);
  }

  .brief-weight__figure {
    display: block;
    color: var(--slop-amber);
    font-size: var(--slop-figure-size);
    font-weight: 700;
    line-height: 0.9;
    white-space: nowrap;
  }

  .brief-facts {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  /* .slop-label is inline-block, so a bare dt sits on the same line as its dd
     and "Due" runs into the date. Each pair is its own two-line stack. */
  .brief-facts dt {
    display: block;
  }

  .brief-facts dd {
    margin: 0.25rem 0 0;
  }

  .brief-note {
    max-width: 58ch;
    color: var(--slop-ink-2);
    font-size: 0.95rem;
  }

  /* An assessment page is more structured than a week page, and its section
     headers say so: a brief is scanned for the section you need, where a week
     is read straight through. The amber is scoped to pages that carry a brief
     head so it cannot leak onto the weeks. */
  :global(.at-main:has(.brief-head) > h2) {
    color: var(--slop-amber);
  }

  @media (max-width: 34rem) {
    .brief-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
