---
import { Image } from "astro:assets";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import CinematicHero from "../components/CinematicHero.astro";
import CoursePage from "../layouts/CoursePage.astro";
import transmuteImage from "../assets/images/transmute.png";
import { DECISIONS, decisionNumber } from "../lib/decisions";
import { courseMeta, coursePrerequisite } from "../course-config";
import { formatCourseDate } from "../lib/dates";

// The home page is a sequence of scenes rather than a stack of card grids: an
// opening, the claim the course is built on, the four things the mode takes,
// the turn that the course exists to make, the twelve decisions as one match,
// the moment the rules themselves change, then the academic apparatus — who it
// is for, what is marked, who teaches it.
//
// Each scene has a different density and a different job. That is the whole
// argument for the structure: a reader scrolling this page should feel the
// course narrowing from a claim to a syllabus.

const CONSTRAINTS = [
  { slug: "no-pick", label: "No pick", line: "You do not choose your champion. The bench narrows the loss; it does not restore the choice." },
  { slug: "one-lane", label: "One lane", line: "There is no map to rotate around. Every decision happens in the same corridor, in front of everyone." },
  { slug: "no-recall", label: "No recall", line: "You cannot retreat and reset at will. Spending is coupled to dying, which prices every death twice." },
  { slug: "forced-contact", label: "Forced contact", line: "You cannot decline the fight. Disengagement buys seconds, not the ten minutes a Rift player can spend elsewhere." },
];

const lectures = (await getPublishedCollection("lectures")).sort(
  (a, b) => a.data.week - b.data.week,
);
const assessments = (await getPublishedCollection("assessments")).sort(
  (a, b) => a.data.due.getTime() - b.data.due.getTime(),
);
const lectureByWeek = new Map(lectures.map((lecture) => [lecture.data.week, lecture]));
---

<CoursePage
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
>
  <CinematicHero
    slot="hero"
    code={`${courseMeta.code} · ${courseMeta.session} ${courseMeta.year}`}
    titleLines={["Hex ARAM", "The hand you're dealt"]}
    subject="Decision-making in the League of Legends mode that deals you a champion, gives you one lane, and will not let you leave it."
    thesis="You don't need better rolls. You need better decisions."
    alt="Two inks on near-black: a single walled corridor spanning the frame, a marker's earlier positions fading out behind it, and a hazard-striped barrier closing the far end"
  />

  {/* Scene 2 — the claim, alone on its ground. */}
  <section class="scene scene-bleed scene--thesis" aria-labelledby="thesis">
    <div class="scene__inner scene__inner--wide">
      <h2 id="thesis" class="slop-statement" data-reveal>
        The game takes<br />choices <em>away</em>.
      </h2>
      <p class="scene__support" data-reveal>
        Most writing about this mode treats it as the Rift with the interesting
        parts removed. That view is common, it is wrong, and correcting it is
        the whole purpose of the course.
      </p>
    </div>
  </section>

  {/* Scene 3 — the four removals, staggered rather than gridded. */}
  <section class="scene scene-bleed scene--alt" aria-labelledby="constraints">
    <div class="scene__inner scene__inner--wide">
      <p class="slop-label" data-reveal>What the mode removes</p>
      <h2 id="constraints" class="visually-hidden">The four constraints</h2>
      <ol class="constraints" data-reveal-stagger>
        {
          CONSTRAINTS.map((constraint, i) => (
            <li class="constraint" data-reveal>
              <span class="constraint__index slop-figure">{decisionNumber(i + 1)}</span>
              <h3 class="constraint__label">{constraint.label}</h3>
              <p class="constraint__line">{constraint.line}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Scene 4 — the turn. */}
  <section class="scene scene-bleed scene--turn" aria-labelledby="turn">
    <div class="scene__inner scene__inner--wide">
      <h2 id="turn" class="slop-statement" data-reveal>
        So where does<br />skill go?
      </h2>
      <div class="scene__pair">
        <p data-reveal>
          Every decision the mode removes at the point of <em>selection</em>{" "}
          reappears, harder, at the point of <em>interpretation</em>. You are
          handed a champion and must work out what it can be made to do for this
          team, against this enemy, with the augments you happen to be offered.
        </p>
        <p data-reveal>
          That is not less strategic than drafting. It is strategy without the
          comfort of having chosen the problem — and it is the only part of this
          mode that rewards knowing more than the population-level answer.
        </p>
      </div>
    </div>
  </section>

  {/* Scene 5 — the twelve weeks as one match. */}
  <section class="scene scene-bleed scene--sequence" aria-labelledby="sequence">
    <div class="scene__inner scene__inner--wide">
      <p class="slop-label" data-reveal>Twelve weeks, one game</p>
      <h2 id="sequence" class="scene__heading" data-reveal>
        The course is ordered by the decisions the game forces, not by difficulty.
      </h2>
      <ol class="sequence" data-reveal-stagger>
        {
          DECISIONS.map((decision) => {
            const lecture = lectureByWeek.get(decision.week);
            return (
              <li class="sequence__item" data-reveal>
                <a href={lecture ? withBase(`/lectures/${lecture.id}/`) : withBase("/lectures/")}>
                  <span class="sequence__num slop-figure">{decisionNumber(decision.week)}</span>
                  <span class="sequence__verb">{decision.verb}</span>
                  <span class="sequence__gloss">{decision.gloss}</span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  {/* Scene 6 — variance, and the only place prismatic belongs on this page. */}
  <section class="scene scene-bleed scene--augment" aria-labelledby="augment">
    <div class="augment__media">
      <Image
        src={transmuteImage}
        alt="The same hand of five cards, with the one already dealt turned prismatic and throwing coloured fragments"
        widths={[768, 1536, 2000]}
        sizes="100vw"
        loading="lazy"
        class="augment__image"
      />
    </div>
    <div class="scene__inner scene__inner--wide augment__content">
      <h2 id="augment" class="slop-statement" data-reveal>
        Sometimes the game<br />changes the rules.
      </h2>
      <p class="scene__support" data-reveal>
        Augments hand you power you did not build toward, on a timer you do not
        control. A statistically stronger augment can still be the wrong pick in
        this game — and telling those apart is week 4's whole subject.
      </p>
      <p data-reveal>
        <a class="slop-button slop-button--ghost" href={withBase("/lectures/week-04/")}>
          Read decision 04
        </a>
      </p>
    </div>
  </section>

  {/* Scene 7 — the academic apparatus, deliberately denser. */}
  <section class="scene scene-bleed scene--alt" aria-labelledby="who">
    <div class="scene__inner scene__inner--wide">
      <div class="scene__split">
        <div>
          <p class="slop-label" data-reveal>Who it is for</p>
          <h2 id="who" class="scene__heading" data-reveal>
            Postgraduate, and not a course in improving your rank.
          </h2>
          <p data-reveal>
            Offered as <strong>{courseMeta.code}</strong> and, at undergraduate
            level, as <strong>SLOP4223</strong>. The prerequisite is
            {" "}{coursePrerequisite}: you are assumed to know how damage,
            itemisation, levelling and objectives work, and the course does not
            re-teach them.
          </p>
          <p data-reveal>
            It will not tell you which champion or augment to take. If what you
            want is the current strongest option, that information is free and
            current on Hexdata, and this course spends twelve weeks explaining
            why it is not the same thing as the right decision.
          </p>
        </div>
        <div>
          <p class="slop-label" data-reveal>What you leave with</p>
          <ul class="outcomes" data-reveal-stagger>
            {courseMeta.learningOutcomes.map((outcome) => <li data-reveal>{outcome}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Scene 8 — assessment: structured, dense, unanimated beyond the reveal. */}
  <section class="scene scene-bleed" aria-labelledby="assessment">
    <div class="scene__inner scene__inner--wide">
      <p class="slop-label" data-reveal>Assessment</p>
      <h2 id="assessment" class="scene__heading" data-reveal>
        Three written accounts of decisions. Marked on the argument, never the
        outcome.
      </h2>
      <ul class="assessments" data-reveal-stagger>
        {
          assessments.map((assessment) => (
            <li class="assessment" data-reveal>
              <a href={withBase(`/assessments/${assessment.id}/`)}>
                <span class="assessment__weight slop-figure">{assessment.data.weight}%</span>
                <span class="assessment__title">{assessment.data.title}</span>
                <span class="assessment__due slop-label slop-label--mono slop-label--quiet">
                  Due {formatCourseDate(assessment.data.due)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="scene__support" data-reveal>
        All three are marked on the same four criteria: quality of reasoning
        under uncertainty 40, identification of the real trade-off 30, use of
        evidence 20, clarity of the account 10. A well-argued defence of a
        choice that lost the game earns full marks.
      </p>
    </div>
  </section>

  {/* Scene 9 — the convener, minimal. */}
  <section class="scene scene--tight scene-bleed scene--alt" aria-labelledby="convener">
    <div class="scene__inner scene__inner--wide">
      <div class="convener" data-reveal>
        <div>
          <p class="slop-label">Convened by</p>
          <h2 id="convener" class="convener__name">Spike</h2>
          <p class="convener__line">
            Game Systems &amp; Decision-Making Lecturer. Argues that the
            interesting part of any game is the part the player was not allowed
            to choose.
          </p>
        </div>
        <p class="convener__links">
          <a href={withBase("/people/spike/")}>Convener's page</a>
          <a href={withBase("/policies/")}>Policies</a>
        </p>
      </div>
      <p class="riot-notice">
        League of Legends is © Riot Games, Inc. This course is not endorsed by,
        affiliated with, or produced by Riot Games.
      </p>
    </div>
  </section>
</CoursePage>

<style>
  .scene__heading {
    margin-block: 0.5rem 1.5rem;
    max-width: 24ch;
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.1rem);
    border: 0;
    padding: 0;
  }

  .scene__support {
    max-width: 52ch;
    margin-block-start: 1.75rem;
    color: var(--slop-ink-2);
    font-size: 1.05rem;
  }

  .scene--thesis {
    padding-block: clamp(5rem, 16vh, 11rem);
  }

  .scene--turn {
    padding-block: clamp(5rem, 14vh, 10rem);
  }

  .scene__pair {
    display: grid;
    gap: 1.5rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
    margin-block-start: 2.5rem;
    color: var(--slop-ink-2);
  }

  .scene__pair em {
    font-style: italic;
    color: var(--slop-ink);
  }

  .scene__split {
    display: grid;
    gap: 2.5rem 4rem;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: start;
  }

  /* Constraints: a staggered column, deliberately not four equal cards. Each
     one steps further in, so the eye reads them as a sequence of removals
     rather than a set of features. */
  .constraints {
    display: grid;
    gap: 0;
    margin-block: 2rem 0;
    padding: 0;
    list-style: none;
    counter-reset: constraint;
  }

  .constraint {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0 1.5rem;
    padding-block: 1.75rem;
    border-block-start: var(--slop-rule);
  }

  .constraint:nth-child(2) { margin-inline-start: 2rem; }
  .constraint:nth-child(3) { margin-inline-start: 4rem; }
  .constraint:nth-child(4) { margin-inline-start: 6rem; }

  .constraint__index {
    color: var(--slop-amber);
    font-size: 0.85rem;
    padding-block-start: 0.35rem;
  }

  .constraint__label {
    margin: 0;
    font-size: clamp(1.35rem, 1rem + 1.6vw, 2rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .constraint__line {
    grid-column: 2;
    margin-block: 0.5rem 0;
    max-width: 56ch;
    color: var(--slop-ink-2);
  }

  /* The twelve decisions as a pipeline. Not a card grid: a run of numbered
     steps that wraps, with the arrow implied by the rule between them. */
  .sequence {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr));
    gap: 0;
    margin-block: 2rem 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--slop-rule);
  }

  .sequence__item a {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: 1.1rem 1rem 1.35rem 0;
    border-block-end: var(--slop-rule);
    color: inherit;
    text-decoration: none;
    transition: background var(--motion-fast) var(--ease-standard);
  }

  .sequence__item a:hover,
  .sequence__item a:focus-visible {
    background: rgb(243 183 0 / 8%);
  }

  .sequence__num {
    color: var(--slop-amber);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .sequence__verb {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .sequence__gloss {
    color: var(--slop-ink-muted);
    font-size: 0.85rem;
    line-height: 1.35;
  }

  /* Augment break: the one full-bleed media scene, and the one place the
     prismatic system appears on this page. */
  .scene--augment {
    position: relative;
    padding-block: clamp(6rem, 20vh, 12rem);
    isolation: isolate;
  }

  .augment__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .augment__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--slop-bg) 30%, rgb(9 9 9 / 70%) 58%, rgb(9 9 9 / 15%)),
      linear-gradient(to top, var(--slop-bg), transparent 45%);
  }

  .augment__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .augment__content .scene__support {
    max-width: 46ch;
  }

  .outcomes {
    margin-block: 1rem 0;
    padding-inline-start: 1.1rem;
    color: var(--slop-ink-2);
  }

  .outcomes li {
    margin-block: 0.5rem;
  }

  /* Assessment: dense, tabular, and the numbers do the talking. */
  .assessments {
    display: grid;
    margin-block: 1.5rem 0;
    padding: 0;
    list-style: none;
    border-block-start: var(--slop-rule);
  }

  .assessment a {
    display: grid;
    grid-template-columns: minmax(7rem, max-content) minmax(0, 1fr) auto;
    gap: 0.35rem 1.5rem;
    align-items: baseline;
    padding-block: 1.35rem;
    border-block-end: var(--slop-rule);
    color: inherit;
    text-decoration: none;
    transition: background var(--motion-fast) var(--ease-standard);
  }

  .assessment a:hover,
  .assessment a:focus-visible {
    background: rgb(243 183 0 / 8%);
  }

  .assessment__weight {
    white-space: nowrap;
    color: var(--slop-amber);
    font-size: var(--slop-figure-size);
    font-weight: 700;
    line-height: 1;
  }

  .assessment__title {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .convener {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    justify-content: space-between;
    align-items: end;
  }

  .convener__name {
    margin-block: 0.35rem 0.5rem;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
    border: 0;
    padding: 0;
  }

  .convener__line {
    max-width: 48ch;
    margin: 0;
    color: var(--slop-ink-2);
  }

  .convener__links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
  }

  .riot-notice {
    margin-block-start: 3rem;
    color: var(--slop-ink-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 52rem) {
    .scene__split {
      grid-template-columns: 1fr;
    }

    .constraint:nth-child(n) {
      margin-inline-start: 0;
    }

    .constraint {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0 1rem;
    }

    .assessment a {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }

    .augment__media::after {
      background:
        linear-gradient(to top, var(--slop-bg) 25%, rgb(9 9 9 / 70%) 75%, rgb(9 9 9 / 45%));
    }
  }
</style>
