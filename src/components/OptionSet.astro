---
// A set of options as they are offered, each read twice.
//
// This is the Type B figure. Week 3 is handed a champion and prices keeping it
// against rerolling; week 4 is offered three augments and prices the ranking
// against the marginal value. Both are the same shape --- a small fixed set, no
// way to see the one you were not offered, and two readings of each that
// disagree --- so they are the same component, with the pair of readings named
// by the week rather than baked in.
//
// The options are kinds and cases, never invented items with invented numbers.
// Both weeks argue that a population figure answers a different question from
// the one the reader has, and putting a fabricated figure on the card would
// contradict the page it sits on.

interface Read {
  /** What this reading is: "The ranking", "What you pay". */
  label: string;
  text: string;
}

interface Option {
  title: string;
  reads: Read[];
  /** Marks the option the case argues for. */
  chosen?: boolean;
}

interface Props {
  label?: string;
  /** The game the options are being read against. */
  context?: string;
  options: Option[];
  /** What the chosen option is chosen for. */
  verdict?: string;
  /** The prismatic border, which §10 reserves for the mode's randomness. */
  prismatic?: boolean;
  provenance?: string;
}

const {
  label = "The offer",
  context,
  options,
  verdict = "Adds the most",
  prismatic = false,
  provenance,
} = Astro.props;
---

<figure class="offer" data-reveal>
  <figcaption class="offer__head">
    <span class="slop-label">{label}</span>
    {context && <p class="offer__context">{context}</p>}
  </figcaption>
  <ol class="offer__set" style={`--offer-columns: ${options.length}`}>
    {
      options.map((option, index) => (
        <li
          class:list={[
            "offer__card",
            prismatic && "slop-prismatic",
            !prismatic && "offer__card--plain",
            option.chosen && "is-chosen",
          ]}
        >
          <span class="offer__index slop-label slop-label--mono slop-label--quiet">
            Option {index + 1}
          </span>
          <h3 class="offer__title">{option.title}</h3>
          <dl class="offer__reads">
            {option.reads.map((read) => (
              <div>
                <dt class="slop-label slop-label--quiet">{read.label}</dt>
                <dd>{read.text}</dd>
              </div>
            ))}
          </dl>
          {option.chosen && <span class="offer__verdict">{verdict}</span>}
        </li>
      ))
    }
  </ol>
  {provenance && <p class="offer__provenance">{provenance}</p>}
</figure>

<style>
  .offer {
    margin-block: 2.5rem;
  }

  .offer__head {
    padding-block-end: 1rem;
  }

  .offer__context {
    margin-block: 0.5rem 0;
    max-width: 62ch;
    color: var(--slop-ink-2);
  }

  .offer__set {
    display: grid;
    grid-template-columns: repeat(var(--offer-columns, 3), minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .offer__card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.15rem 1.25rem;
  }

  /* Without the prismatic edge the card still needs a boundary. Plain rules,
     because the second colour system means augments and randomness --- a
     reroll is priced in the site's own black and amber. */
  .offer__card--plain {
    border: var(--slop-rule);
    background: var(--slop-bg-2);
  }

  /* The chosen option is marked in amber, not by making its prismatic edge
     louder. The prismatic border says "this came out of the randomness";
     amber says "this is the one the argument lands on". Two different claims,
     and they should not be made in the same colour. */
  .offer__card.is-chosen {
    box-shadow: inset 3px 0 0 var(--slop-amber);
  }

  .offer__title {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .offer__reads {
    display: grid;
    gap: 0.75rem;
    margin: 0.35rem 0 0;
  }

  .offer__reads dd {
    margin: 0.2rem 0 0;
    color: var(--slop-ink-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .offer__verdict {
    margin-block-start: auto;
    padding-block-start: 0.75rem;
    color: var(--slop-amber);
    font-family: var(--at-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .offer__provenance {
    margin-block: 1rem 0;
    padding-block-start: 0.75rem;
    border-block-start: var(--slop-rule);
    color: var(--slop-ink-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (max-width: 46rem) {
    .offer__set {
      grid-template-columns: minmax(0, 1fr);
    }

    .offer__card.is-chosen {
      box-shadow: inset 0 3px 0 var(--slop-amber);
    }
  }
</style>
