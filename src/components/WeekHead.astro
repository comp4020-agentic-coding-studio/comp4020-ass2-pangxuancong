---
import { withBase } from "astro-theme-university/url";
import { decisionFor, decisionNumber } from "../lib/decisions";

// What a week opens with, under the heading: the claim at editorial scale, the
// constraints it argues about, and the decision number set large and faint
// behind them. One decision, paid out twelve times — a reader who lands here
// from a search result sees which decision this is, what it argues, and which
// of the mode's four removals it argues about, in one screen.

interface Props {
  week: number;
  claim?: string;
  constraints?: string[];
  slides?: string;
}

const CONSTRAINT_LABELS: Record<string, string> = {
  "no-pick": "no pick",
  "no-recall": "no recall",
  "one-lane": "one lane",
  "forced-contact": "forced contact",
};

const { week, claim, constraints = [], slides } = Astro.props;
const decision = decisionFor(week);
---

<div class="week-head">
  <span class="week-head__watermark slop-figure" aria-hidden="true">{decisionNumber(week)}</span>

  {claim && (
    <blockquote class="week-head__claim">
      <p class="slop-label slop-label--quiet">The claim</p>
      <p>{claim}</p>
    </blockquote>
  )}

  {decision && <p class="week-head__verb slop-label slop-label--quiet">The decision: {decision.gloss}</p>}

  {
    constraints.length > 0 && (
      <>
        <h2 class="visually-hidden">Constraints this week is about</h2>
        <ul class="slop-chips">
          {constraints.map((slug) => (
            <li>{CONSTRAINT_LABELS[slug] ?? slug}</li>
          ))}
        </ul>
      </>
    )
  }

  {slides && (
    <p class="week-head__slides">
      <a class="slop-button slop-button--ghost" href={withBase(slides)}>Open the lecture slides</a>
    </p>
  )}
</div>

<style>
  .week-head {
    position: relative;
    margin-block-end: 2.5rem;
    padding-block-end: 1.75rem;
    border-block-end: var(--slop-rule);
    isolation: isolate;
  }

  /* The decision number as editorial composition rather than decoration: it is
     the same number the rail and the page heading carry, set large enough to
     be a shape and faint enough not to compete with the claim. */
  .week-head__watermark {
    position: absolute;
    z-index: -1;
    inset-block-start: -2.5rem;
    inset-inline-end: -0.5rem;
    font-size: clamp(6rem, 4rem + 12vw, 14rem);
    font-weight: 700;
    line-height: 1;
    color: var(--slop-ink);
    opacity: 0.045;
    pointer-events: none;
    user-select: none;
  }

  /* The heading already carries the week's argument at display scale, so the
     claim is set as what it is — the disputable sentence the week can be
     argued with over — rather than as a second headline competing with the
     first. */
  .week-head__claim {
    margin-block: 0;
    padding-inline-start: 1.25rem;
    border-inline-start: var(--slop-rule-heavy);
    max-width: 46ch;
  }

  .week-head__claim p:last-child {
    margin-block: 0.35rem 0;
    color: var(--slop-ink);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .week-head__verb {
    margin-block: 1rem 1.25rem;
  }

  .week-head__slides {
    margin-block: 1.5rem 0;
  }
</style>
