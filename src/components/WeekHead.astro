---
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

// The block every teaching week opens with: the week number at display size,
// the claim set as an editorial headline, and the constraints the week is
// about. One decision, paid out twelve times — a reader who lands on week 9
// from a search result can see in one screen which week this is, what it
// argues, and which of the mode's four removals it argues about.

interface Props {
  week: number;
  date: Date;
  claim?: string;
  constraints?: string[];
  slides?: string;
}

const CONSTRAINT_LABELS: Record<string, string> = {
  "no-pick": "no pick",
  "no-recall": "no recall",
  "one-lane": "one lane",
  "forced-contact": "forced contact",
};

const { week, date, claim, constraints = [], slides } = Astro.props;
---

<div class="week-head">
  <p class="week-meta">
    <span class="slop-label slop-label--mono">Week {week}</span>
    <span class="week-date">{formatCourseDate(date)}</span>
  </p>

  {claim && <p class="slop-claim">{claim}</p>}

  {
    constraints.length > 0 && (
      <>
        <h2 class="visually-hidden">Constraints this week is about</h2>
        <ul class="slop-chips">
          {constraints.map((slug) => (
            <li>{CONSTRAINT_LABELS[slug] ?? slug}</li>
          ))}
        </ul>
      </>
    )
  }

  {slides && (
    <p class="week-slides">
      <a href={withBase(slides)}>Open the lecture slides</a>
    </p>
  )}
</div>

<style>
  .week-head {
    margin-block-end: 2.5rem;
    padding-block-end: 1.5rem;
    border-block-end: var(--slop-rule);
  }

  .week-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-block: 0;
  }

  .week-date {
    color: var(--at-text-muted);
    font-size: 0.9rem;
  }

  .week-slides {
    margin-block: 1.25rem 0;
  }
</style>
