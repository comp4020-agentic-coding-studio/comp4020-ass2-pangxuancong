---
import { withBase } from "astro-theme-university/url";
import { decisionNumber } from "../lib/decisions";

// Previous and next, named as what they are. `NEXT DECISION 10 — THE CORRECT
// BUILD SHOULD CHANGE MID-GAME` tells a reader where they are going; `Next`
// tells them only that there is a next.

interface Neighbour {
  id: string;
  week: number;
  title: string;
}

interface Props {
  previous?: Neighbour;
  next?: Neighbour;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav class="week-footer" aria-label="Adjacent decisions">
      {previous ? (
        <a class="week-footer__link" href={withBase(`/lectures/${previous.id}/`)} rel="prev">
          <span class="slop-label slop-label--quiet">Previous decision</span>
          <span class="week-footer__title">
            <span class="slop-figure">{decisionNumber(previous.week)}</span> — {previous.title}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="week-footer__link week-footer__link--next" href={withBase(`/lectures/${next.id}/`)} rel="next">
          <span class="slop-label slop-label--quiet">Next decision</span>
          <span class="week-footer__title">
            <span class="slop-figure">{decisionNumber(next.week)}</span> — {next.title}
          </span>
        </a>
      )}
    </nav>
  )
}

<style>
  .week-footer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 0;
    margin-block-start: 3rem;
    border-block-start: var(--slop-rule);
  }

  .week-footer__link {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.5rem;
    padding-inline-end: 1.5rem;
    color: inherit;
    text-decoration: none;
    transition: background var(--motion-fast) var(--ease-standard);
  }

  .week-footer__link--next {
    text-align: right;
    padding-inline: 1.5rem 0;
  }

  .week-footer__link:hover,
  .week-footer__link:focus-visible {
    background: rgb(243 183 0 / 8%);
  }

  .week-footer__title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .week-footer__title .slop-figure {
    color: var(--slop-amber);
  }

  @media (max-width: 40rem) {
    .week-footer__link--next {
      text-align: left;
      padding-inline: 0 1.5rem;
      border-block-start: var(--slop-rule);
    }
  }
</style>
